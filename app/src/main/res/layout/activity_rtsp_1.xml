
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp">
        <EditText android:id="@+id/rtsp_input"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="rtsp://admin:pass@ip:554/stream"
            android:textColor="#FFF" android:textColorHint="#AAA"
            android:singleLine="true"/>
        <Button android:id="@+id/btn_play" android:text="PLAY"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btn_stop" android:text="STOP"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btn_back" android:text="BACK"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
